<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Für CalDAV-Sync mit Nextcloud (auch im Release-Build nötig!). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Für lokale Erinnerungen (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Damit geplante Erinnerungen einen Neustart überleben. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Für In-App-Update: heruntergeladenes APK installieren. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Damit der Hintergrund-Sync (Erinnerungen) nicht von der Akku-Optimierung
         abgewürgt wird – Nutzer kann die App ausnehmen. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Für die Sprach-Schnelleingabe (speech_to_text). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Für pünktliche Erinnerungen/Tages-Briefing (exakte Alarme). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <!-- Health Connect: nur lesen. Je Datenart eine eigene Berechtigung; was hier
         fehlt, bietet Health Connect im Dialog gar nicht erst an. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION"/>
    <uses-permission android:name="android.permission.health.READ_WEIGHT"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED"/>
    <uses-permission android:name="android.permission.health.READ_DISTANCE"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE"/>
    <!-- Mehr als die letzten 30 Tage, und Lesen ohne geöffnete App (für den
         späteren Abruf alle 30 Minuten). -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY"/>
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"/>
    <application
        android:label="Unser Familien-Organizer"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Flutters Auto-Deeplinking aus: Widget-URLs (familyplanner://…)
                 dürfen NICHT als Router-Seite interpretiert werden – wir
                 verarbeiten Widget-Klicks selbst in der AppShell. -->
            <meta-data
              android:name="flutter_deeplinking_enabled"
              android:value="false"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect: Begründung der Berechtigungen anzeigen. -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
            <!-- Text aus anderen Apps teilen → Schnell-Eingabe. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>
        <!-- Ab Android 14 verlangt Health Connect diesen Einstieg („Datenschutz"),
             sonst erscheint der Berechtigungsdialog gar nicht. Führt in die App. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
        <!-- Plant geplante Erinnerungen nach einem Neustart neu ein. -->
        <receiver android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <!-- Home-Screen-Widget: Anstehende Termine.
             exported=true, damit das System onUpdate beim Platzieren selbst
             aufruft (sonst bleibt das Widget auf dem System-Platzhalter). -->
        <receiver android:name=".NextEventsWidget" android:exported="true"
            android:label="Anstehende Termine">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/fp_widget_next"/>
        </receiver>
        <receiver android:name=".CountdownWidget" android:exported="true"
            android:label="Countdown">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/fp_widget_countdown"/>
        </receiver>
        <receiver android:name=".DesignWidget" android:exported="true"
            android:label="Termine (Design, mit + Knopf)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/fp_widget_design"/>
        </receiver>
        <receiver android:name=".FitnessWidget" android:exported="true"
            android:label="Gesundheit">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/fp_widget_fitness"/>
        </receiver>
        <receiver android:name=".QuickAddWidget" android:exported="true"
            android:label="Schnell-Eingabe">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/fp_widget_quickadd"/>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Damit url_launcher den Browser für die Releases-Seite öffnen kann. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <!-- Damit die App erkennt, ob Health Connect installiert ist. -->
        <package android:name="com.google.android.apps.healthdata"/>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
        <!-- Damit speech_to_text den System-Spracherkenner findet (Android 11+). -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
    </queries>
</manifest>
